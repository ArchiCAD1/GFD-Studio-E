#!/bin/sh
# The lvds command of the installed app (command line, MCP server, local API): lvds help
# Runs lvds.mjs, beside this file, with the app itself as its Node runtime (ELECTRON_RUN_AS_NODE):
# no window opens and no separate Node is needed.
self=$0
while [ -L "$self" ]; do   # started through a link, such as one in /usr/local/bin
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
app="$here/../../MacOS/LV Design Studio"              # macOS: <app>/Contents/Resources/lvds
[ -x "$app" ] || app="$here/../../lv-design-studio"   # Linux: <app folder>/resources/lvds
if [ ! -x "$app" ]; then echo "lvds: LV Design Studio was not found beside $here" >&2; exit 2; fi
ELECTRON_RUN_AS_NODE=1 exec "$app" "$here/lvds.mjs" "$@"
